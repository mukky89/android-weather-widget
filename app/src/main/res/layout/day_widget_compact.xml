<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/day_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<LinearLayout android:id="@+id/day_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/day_background" android:padding="5dp">
<LinearLayout android:id="@+id/day_toolbar" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginBottom="4dp" android:paddingStart="8dp" android:paddingEnd="2dp" android:orientation="horizontal" android:gravity="center_vertical">
<LinearLayout android:id="@+id/day_alarm_area" android:layout_width="90dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:background="?android:attr/selectableItemBackground">
<TextView android:layout_width="match_parent" android:layout_height="12dp" android:text="BUDÍK" android:textSize="8sp" android:letterSpacing="0.08" android:textColor="#91ABC9" android:includeFontPadding="false" android:importantForAccessibility="no"/>
<TextView android:id="@+id/day_alarm" android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center_vertical" android:text="Budík" android:textSize="12sp" android:textColor="#E5EFFF" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
</LinearLayout>
<ImageView android:importantForAccessibility="no" android:layout_width="1dp" android:layout_height="25dp" android:layout_marginEnd="10dp" android:background="#427B95B4"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:orientation="vertical" android:gravity="center_vertical">
<TextView android:layout_width="match_parent" android:layout_height="12dp" android:text="MENINY" android:textSize="8sp" android:letterSpacing="0.08" android:textColor="#91ABC9" android:includeFontPadding="false" android:importantForAccessibility="no"/>
<TextView android:id="@+id/day_names" android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center_vertical" android:text="Meniny" android:textSize="12sp" android:textColor="#E5EFFF" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
</LinearLayout>
<ImageView android:id="@+id/day_refresh" android:layout_width="34dp" android:layout_height="36dp" android:padding="7dp" android:src="@drawable/ic_refresh" android:background="@drawable/day_control" android:contentDescription="Obnoviť počasie a udalosti"/>
<ImageView android:id="@+id/day_settings" android:layout_width="34dp" android:layout_height="36dp" android:layout_marginStart="4dp" android:padding="7dp" android:src="@drawable/ic_settings" android:background="@drawable/day_control" android:contentDescription="Nastavenia widgetu Deň"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="92dp" android:orientation="horizontal" android:background="@drawable/day_card" android:paddingStart="10dp" android:paddingEnd="8dp" android:gravity="center_vertical">
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
<TextClock android:id="@+id/day_clock" android:layout_width="match_parent" android:layout_height="68dp" android:format12Hour="HH:mm" android:format24Hour="HH:mm" android:textSize="68sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="28sp" android:autoSizeMaxTextSize="72sp" android:autoSizeStepGranularity="2sp" android:fontFamily="sans-serif-light" android:gravity="center_vertical" android:textColor="#FFFFFF" android:includeFontPadding="false" android:maxLines="1" android:contentDescription="Hodiny · otvoriť budíky"/>
<TextClock android:id="@+id/day_date" android:layout_width="match_parent" android:layout_height="24dp" android:format12Hour="EEE, d. M. yyyy" android:format24Hour="EEE, d. M. yyyy" android:textSize="15sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" android:textColor="#DCE6F4" android:maxLines="1" android:includeFontPadding="false"/>
</LinearLayout>
<LinearLayout android:id="@+id/day_weather_card" android:layout_width="128dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
<TextView android:id="@+id/day_city" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Počasie podľa GPS" android:textSize="13sp" android:gravity="end" android:textColor="#FFFFFF" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical|end">
<ImageView android:id="@+id/day_weather_icon" android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/weather_cloud" android:contentDescription="Počasie"/>
<TextView android:id="@+id/day_temperature" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—°" android:textSize="36sp" android:fontFamily="sans-serif-light" android:textColor="#FFFFFF" android:includeFontPadding="false"/>
</LinearLayout>
<TextView android:id="@+id/day_weather" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Počasie" android:textSize="10sp" android:gravity="end" android:textColor="#DCE6F4" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
</LinearLayout></LinearLayout>
